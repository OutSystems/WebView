<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(TargetDotnetVersion)</TargetFramework>
    <RootNamespace>WebViewControl</RootNamespace>
    <AssemblyTitle>WebViewControl Avalonia</AssemblyTitle>
    <Description>WebViewControl for Avalonia powered by the native web view of the operating system (WKWebView on macOS) instead of a bundled Chromium</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Configuration></Configuration>
    <Company></Company>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>WebViewControl-Avalonia$(PackageSuffix)</PackageId>
    <Configurations>Debug;Release;ReleaseAvalonia;ReleaseWPF;ReleaseAvaloniaRemoteDebugSupport</Configurations>
  </PropertyGroup>

  <PropertyGroup>
    <!-- the sources shared with the WPF (cef based) project have a few differences: no CefGlue types -->
    <DefineConstants>$(DefineConstants);NATIVE_WEBVIEW</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'ReleaseAvaloniaRemoteDebugSupport'">
    <DefineConstants>$(DefineConstants);REMOTE_DEBUG_SUPPORT</DefineConstants>
    <PackageId>WebViewControl-Avalonia-RemoteDebugSupport$(PackageSuffix)</PackageId>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'ReleaseAvalonia'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\WebViewControl\AssemblyCache.cs" Link="AssemblyCache.cs" />
    <Compile Include="..\WebViewControl\GlobalSettings.cs" Link="GlobalSettings.cs" />
    <Compile Include="..\WebViewControl\ProxyAuthentication.cs" Link="ProxyAuthentication.cs" />
    <Compile Include="..\WebViewControl\RenderProcessTerminatedException.cs" Link="RenderProcessTerminatedException.cs" />
    <Compile Include="..\WebViewControl\ResourcesManager.cs" Link="ResourcesManager.cs" />
    <Compile Include="..\WebViewControl\ResourceUrl.cs" Link="ResourceUrl.cs" />
    <Compile Include="..\WebViewControl\UnhandledAsyncExceptionEventArgs.cs" Link="UnhandledAsyncExceptionEventArgs.cs" />
    <Compile Include="..\WebViewControl\UrlHelper.cs" Link="UrlHelper.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--When we upload Avalonia here, we should increase the version of both WebViewControl.Avalonia as well as ReactViewControl.Avalonia-->
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <!-- JS side of the native <-> javascript bridge, injected in every document before any page script runs -->
    <EmbeddedResource Include="Resources\NativeBridge.js" LogicalName="WebViewControl.Native.NativeBridge.js" />
  </ItemGroup>

</Project>
